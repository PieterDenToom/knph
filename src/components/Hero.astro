---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import { useTranslations, localizedHref, type Locale } from "../i18n";
import clinicImg from "../assets/clinic.webp";

interface Props {
  lang?: Locale;
}
const { lang = "en" } = Astro.props;
const t = useTranslations(lang);
---

<section class="hero">
  <div class="bg-blob bg-blob-1" aria-hidden="true"></div>
  <div class="bg-blob bg-blob-2" aria-hidden="true"></div>
  <div class="container grid">
    <div class="text">
      <span class="eyebrow">{t.home.hero.eyebrow}</span>
      <h1>{t.home.hero.title}</h1>
      <p class="lead">{t.home.hero.lead}</p>
      <div class="cta">
        <a
          href={localizedHref("/health-screening", lang)}
          class="btn btn-primary"
          id="hero-cta-screening"
        >
          {t.home.hero.ctaPrimary}
          <svg
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14M13 5l7 7-7 7"></path>
          </svg>
        </a>
        <a href={localizedHref("/contact", lang)} class="btn btn-ghost" id="hero-cta-contact"
          >{t.home.hero.ctaSecondary}</a
        >
      </div>

      <ul class="trust">
        <li>
          <Icon name="family" size={18} />
          <span>{t.home.hero.trust.family}</span>
        </li>
        <li>
          <Icon name="shield" size={18} />
          <span>{t.home.hero.trust.registered}</span>
        </li>
        <li>
          <Icon name="clock" size={18} />
          <span>{t.home.hero.trust.walkins}</span>
        </li>
      </ul>
    </div>

    <div class="visual" aria-hidden="true">
      <div class="visual-card v1">
        <div class="icon"><Icon name="stethoscope" size={22} /></div>
        <div>
          <div class="t">{t.home.hero.cards.consult.title}</div>
          <div class="s">{t.home.hero.cards.consult.sub}</div>
        </div>
      </div>
      <div class="visual-card v2">
        <div class="icon"><Icon name="syringe" size={22} /></div>
        <div>
          <div class="t">{t.home.hero.cards.vacc.title}</div>
          <div class="s">{t.home.hero.cards.vacc.sub}</div>
        </div>
      </div>
      <div class="visual-card v3">
        <div class="icon"><Icon name="heart" size={22} /></div>
        <div>
          <div class="t">{t.home.hero.cards.chronic.title}</div>
          <div class="s">{t.home.hero.cards.chronic.sub}</div>
        </div>
      </div>
      <div class="photo">
        <Image src={clinicImg} alt={t.home.hero.photoAlt} class="photo-img" />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(3rem, 6vw, 5rem) 0 clamp(3.5rem, 7vw, 6rem);
    min-height: calc(100vh - 64px);
    min-height: calc(100dvh - 64px);
    display: flex;
    align-items: center;
    background:
      radial-gradient(
        ellipse at top left,
        rgba(196, 181, 253, 0.25) 0%,
        rgba(196, 181, 253, 0) 60%
      ),
      linear-gradient(180deg, #faf9ff 0%, #ffffff 100%);
  }
  .hero > .container {
    width: 100%;
  }
  .bg-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
    z-index: 0;
    pointer-events: none;
  }
  .bg-blob-1 {
    width: 320px;
    height: 320px;
    background: rgba(139, 92, 246, 0.28);
    top: -80px;
    right: -60px;
  }
  .bg-blob-2 {
    width: 260px;
    height: 260px;
    background: rgba(196, 181, 253, 0.4);
    bottom: -80px;
    left: 30%;
  }
  .grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
  h1 {
    margin: 0.5rem 0 1rem;
    max-width: 18ch;
  }
  .lead {
    font-size: clamp(1.05rem, 1.4vw, 1.15rem);
    color: var(--muted);
    max-width: 52ch;
    margin: 0 0 1.75rem;
  }
  .cta {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .trust {
    list-style: none;
    margin: 2.25rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    color: var(--ink-2);
    font-size: 0.92rem;
  }
  .trust li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
  .trust li :global(svg) {
    color: var(--purple-600);
  }

  .visual {
    position: relative;
    aspect-ratio: 1 / 1.05;
    max-width: 460px;
    margin-left: auto;
    width: 100%;
  }
  @media (max-width: 900px) {
    .visual {
      margin: 0 auto;
    }
  }

  .photo {
    position: absolute;
    inset: 0;
    border-radius: 8px;
    overflow: hidden;
    background: linear-gradient(
      160deg,
      var(--purple-100) 0%,
      var(--purple-50) 100%
    );
    box-shadow: var(--shadow-lg);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .photo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .visual-card {
    position: absolute;
    background: #fff;
    border-radius: 6px;
    padding: 0.85rem 1rem;
    box-shadow: var(--shadow-md);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    z-index: 2;
    border: 1px solid var(--line);
    min-width: 180px;
  }
  .visual-card .icon {
    width: 38px;
    height: 38px;
    border-radius: 4px;
    background: var(--purple-50);
    color: var(--purple-700);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .visual-card .t {
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--ink);
  }
  .visual-card .s {
    font-size: 0.78rem;
    color: var(--muted);
  }
  .v1 {
    top: 6%;
    left: -4%;
    animation: float 7s ease-in-out infinite;
  }
  .v2 {
    bottom: 18%;
    right: -8%;
    animation: float 9s ease-in-out infinite -2s;
  }
  .v3 {
    bottom: -2%;
    left: 14%;
    animation: float 8s ease-in-out infinite -4s;
  }
  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-6px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .v1,
    .v2,
    .v3 {
      animation: none;
    }
  }
  @media (max-width: 480px) {
    .visual-card {
      min-width: 150px;
    }
    .v1 {
      left: -2%;
    }
    .v2 {
      right: -4%;
    }
  }
</style>

<script is:inline>
  document.getElementById('hero-cta-screening')?.addEventListener('click', function () {
    window.posthog?.capture('health_screening_cta_clicked', { location: 'hero' });
  });
  document.getElementById('hero-cta-contact')?.addEventListener('click', function () {
    window.posthog?.capture('contact_cta_clicked', { location: 'hero' });
  });
</script>
