---
interface Props {
  name:
    | "stethoscope"
    | "syringe"
    | "heart"
    | "shield"
    | "clipboard"
    | "pill"
    | "phone"
    | "map"
    | "clock"
    | "check"
    | "arrow"
    | "star"
    | "family";
  size?: number;
}
const { name, size = 22 } = Astro.props;

const paths: Record<string, string> = {
