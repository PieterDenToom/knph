---
import Icon from "./Icon.astro";

interface Props {
  icon:
    | "stethoscope"
    | "syringe"
    | "heart"
    | "shield"
    | "clipboard"
    | "pill"
    | "phone"
    | "map"
    | "clock"
    | "check"
    | "star"
    | "family";
  title: string;
  description: string;
  href?: string;
  cta?: string;
}
const { icon, title, description, href, cta = "Learn more" } = Astro.props;
---

<article class="svc">
  <div class="icon-wrap">
    <Icon name={icon} size={26} />
  </div>
  <h3>{title}</h3>
  <p>{description}</p>
  {
    href && (
      <a href={href} class="more">
        {cta}
        <svg
          viewBox="0 0 24 24"
          width="14"
          height="14"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14M13 5l7 7-7 7" />
        </svg>
      </a>
    )
  }
</article>

<style>
  .svc {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 1.75rem;
    transition: transform 0.2s ease, box-shadow 0.2s ease,
      border-color 0.2s ease;
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .svc:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--purple-100);
  }
  .icon-wrap {
    width: 50px;
    height: 50px;
    border-radius: 4px;
    background: linear-gradient(135deg, var(--purple-100), var(--surface));
    color: var(--purple-700);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
    border: 1px solid var(--purple-100);
  }
  h3 {
    margin: 0 0 0.5rem;
    font-size: 1.15rem;
  }
  p {
    margin: 0 0 1rem;
    color: var(--muted);
    font-size: 0.95rem;
    flex-grow: 1;
  }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--purple-700);
  }
  .more:hover {
    color: var(--purple-800);
    gap: 0.55rem;
  }
</style>
