---
// Conversion tracking for every phone / WhatsApp / email link on the site.
// Sends `contact_click` to PostHog and the matching Google Ads conversion.
// Never add health or personal details here: these events go to ad platforms.
import { GOOGLE_ADS_ID } from "../lib/analytics";

// Conversion labels from Google Ads (Goals → Conversions → action → Tag setup).
// A placeholder label is skipped, so only configured methods are reported.
const conversions = {
  phone: `${GOOGLE_ADS_ID}/JQs2CJeb6ZAdENDUueBD`,
  whatsapp: `${GOOGLE_ADS_ID}/vx1ZCMnL55AdENDUueBD`,
  email: `${GOOGLE_ADS_ID}/_7aiCIDG4pAdENDUueBD`,
};
---

<script is:inline define:vars={{ conversions }}>
  // Location comes from the nearest [data-cta-location], falling back to header/footer.
  document.addEventListener('click', function (e) {
    var link = e.target instanceof Element && e.target.closest('a[href]');
    if (!link) return;
    var href = link.getAttribute('href') || '';
    var method =
      href.indexOf('tel:') === 0 ? 'phone' :
      href.indexOf('mailto:') === 0 ? 'email' :
      /^https:\/\/(wa\.me|api\.whatsapp\.com)\//.test(href) ? 'whatsapp' :
      null;
    if (!method) return;
    var tagged = link.closest('[data-cta-location]');
    var ctaLocation = tagged
      ? tagged.getAttribute('data-cta-location')
      : link.closest('header') ? 'header'
      : link.closest('footer') ? 'footer'
      : 'content';

    window.posthog?.capture(
      'contact_click',
      { contact_method: method, cta_location: ctaLocation, lang: document.documentElement.lang },
      { send_instantly: true }
    );

    var sendTo = conversions[method];
    if (window.gtag && sendTo && sendTo.indexOf('XXXX') === -1) {
      window.gtag('event', 'conversion', { send_to: sendTo });
    }
  });
</script>
