---
import type { CollectionEntry } from "astro:content";
import { useTranslations, localizedHref, type Locale } from "../i18n";

interface Props {
  offer: CollectionEntry<"offers">;
  variant?: "default" | "compact" | "featured";
  maxFeatures?: number;
  lang?: Locale;
  noId?: boolean;
  detailsHref?: string;
  showImage?: boolean;
}

const {
  offer,
  variant = "default",
  maxFeatures,
  lang = "en",
  noId = false,
  detailsHref,
  showImage = true,
} = Astro.props;
const t = useTranslations(lang);
const d = offer.data;

const featured = variant === "featured";
const compact = variant === "compact";

const name = lang === "zh" && d.nameZh ? d.nameZh : d.name;
const tagline = lang === "zh" && d.taglineZh ? d.taglineZh : d.tagline;
const description = lang === "zh" && d.descriptionZh ? d.descriptionZh : d.description;
const badge = lang === "zh" && d.badgeZh ? d.badgeZh : d.badge;
const sample = lang === "zh" && d.sampleZh ? d.sampleZh : d.sample;
const tat = lang === "zh" && d.tatZh ? d.tatZh : d.tat;
const notes = lang === "zh" && d.notesZh.length ? d.notesZh : d.notes;

const visibleFeatures = maxFeatures
  ? d.features.slice(0, maxFeatures)
  : d.features;
const hiddenFeaturesCount =
  maxFeatures && d.features.length > maxFeatures
    ? d.features.length - maxFeatures
    : 0;

const currency = d.currency;
const fmt = (n: number) => `${currency} ${n}`;

const enquireHref = localizedHref("/contact", lang);
const detailsTarget =
  detailsHref ?? `${localizedHref("/health-screening", lang)}#${d.code.toLowerCase()}`;
---

<article
  class:list={["offer", { featured, compact }]}
  id={noId ? undefined : d.code.toLowerCase()}
>
  {
    showImage && (
      <div
        class="card-img"
        style={`--cat-img: url('/categories/${d.category}.webp')`}
        aria-hidden="true"
      />
    )
  }
  {badge && <span class="badge">{badge}</span>}

  <header>
    <span class="code">{t.offer.codePrefix} · {d.code}</span>
    <h3>{name}</h3>
    <p class="tagline">{tagline}</p>
  </header>

  <div class="price-row">
    <div class="price">
      <span class="from">{t.offer.promoLabel}</span>
      <span class="amount">{fmt(d.price.promo)}</span>
      {d.price.normal && <span class="normal">{fmt(d.price.normal)}</span>}
    </div>
    {
      d.price.tagOn && (
        <span class="tag-on">
          {t.offer.tagOnBefore} <strong>{fmt(d.price.tagOn)}</strong>{" "}
          {t.offer.tagOnAfter}
        </span>
      )
    }
  </div>

  {!compact && description && <p class="desc">{description}</p>}

  {
    !compact && d.features.length > 0 && (
      <ul class="features">
        {visibleFeatures.map((f) => (
          <li>
            <svg
              viewBox="0 0 24 24"
              width="14"
              height="14"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12l5 5L20 7" />
            </svg>
            <span>{f}</span>
          </li>
        ))}
        {hiddenFeaturesCount > 0 && (
          <li class="more-count">{t.offer.moreInclusions(hiddenFeaturesCount)}</li>
        )}
      </ul>
    )
  }

  {
    !compact && d.addOn && (
      <details class="addon">
        <summary>
          <span class="addon-label">
            {t.offer.selectAddOns(d.addOn.selectCount)}
          </span>
          <span class="addon-count">
            {t.offer.optionsCount(d.addOn.items.length)}
          </span>
          <svg
            class="chev"
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M6 9l6 6 6-6" />
          </svg>
        </summary>
        <ul class="addon-items">
          {d.addOn.items.map((i) => (
            <li>{i}</li>
          ))}
        </ul>
      </details>
    )
  }

  {
    !compact && (sample || tat) && (
      <dl class="meta">
        {sample && (
          <div>
            <dt>{t.offer.sampleLabel}</dt>
            <dd>{sample}</dd>
          </div>
        )}
        {tat && (
          <div>
            <dt>{t.offer.tatLabel}</dt>
            <dd>{tat}</dd>
          </div>
        )}
      </dl>
    )
  }

  {
    !compact && notes.length > 0 && (
      <ul class="notes">
        {notes.map((n) => (
          <li>{n}</li>
        ))}
      </ul>
    )
  }

  <div class="footer">
    {
      compact ? (
        <a href={detailsTarget} class="btn btn-primary">
          {t.offer.viewDetails}
          <svg
            viewBox="0 0 24 24"
            width="14"
            height="14"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14M13 5l7 7-7 7" />
          </svg>
        </a>
      ) : (
        <a
          href={enquireHref}
          class:list={["btn", featured ? "btn-primary" : "btn-ghost"]}
        >
          {t.offer.enquire}
          <svg
            viewBox="0 0 24 24"
            width="14"
            height="14"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14M13 5l7 7-7 7" />
          </svg>
        </a>
      )
    }
  </div>
</article>

<style>
  .offer {
    position: relative;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease,
      border-color 0.2s ease;
    height: 100%;
  }
  .card-img {
    margin: -1.75rem -1.75rem 0;
    aspect-ratio: 16 / 9;
    background-image: var(--cat-img),
      linear-gradient(135deg, var(--purple-100), var(--purple-50));
    background-size: cover, cover;
    background-position: center, center;
    background-repeat: no-repeat, no-repeat;
    border-bottom: 1px solid var(--line);
  }
  .offer:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--purple-100);
  }
  .offer.featured {
    background: linear-gradient(160deg, #6d28d9 0%, #4c1d95 100%);
    border-color: transparent;
    color: #fff;
    box-shadow: var(--shadow-lg);
  }
  .offer.featured :global(h3),
  .offer.featured .tagline,
  .offer.featured .desc,
  .offer.featured .features li,
  .offer.featured .addon-label,
  .offer.featured .meta dd,
  .offer.featured .amount {
    color: #fff;
  }
  .offer.featured .tagline,
  .offer.featured .desc {
    color: rgba(255, 255, 255, 0.82);
  }
  .offer.featured .features li {
    color: rgba(255, 255, 255, 0.94);
  }
  .offer.featured .features li svg {
    color: #c4b5fd;
  }
  .offer.featured .code,
  .offer.featured .from,
  .offer.featured .meta dt {
    color: rgba(255, 255, 255, 0.65);
  }
  .offer.featured .normal {
    color: rgba(255, 255, 255, 0.5);
  }
  .offer.featured .tag-on {
    color: rgba(255, 255, 255, 0.78);
  }
  .offer.featured .tag-on strong {
    color: #fff;
  }
  .offer.featured .addon {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.15);
  }
  .offer.featured .addon-items li {
    color: rgba(255, 255, 255, 0.85);
    border-color: rgba(255, 255, 255, 0.15);
  }
  .offer.featured .addon-count {
    background: rgba(255, 255, 255, 0.12);
    color: rgba(255, 255, 255, 0.85);
  }
  .offer.featured .btn-primary {
    background: #fff;
    color: var(--purple-800);
  }
  .offer.featured .btn-primary:hover {
    background: var(--purple-50);
  }

  .badge {
    position: absolute;
    top: 1.1rem;
    right: 1.1rem;
    background: var(--purple-100);
    color: var(--purple-800);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
  }
  :global(body.lang-zh) .badge {
    text-transform: none;
    letter-spacing: 0.04em;
  }
  .offer.featured .badge {
    background: rgba(255, 255, 255, 0.18);
    color: #fff;
    backdrop-filter: blur(6px);
  }

  header {
    padding-right: 4rem;
  }
  .code {
    display: block;
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--purple-700);
    margin-bottom: 0.25rem;
  }
  :global(body.lang-zh) .code {
    text-transform: none;
    letter-spacing: 0.04em;
  }
  h3 {
    margin: 0 0 0.35rem;
    font-size: 1.2rem;
  }
  .tagline {
    margin: 0;
    color: var(--muted);
    font-size: 0.93rem;
    line-height: 1.5;
  }

  .price-row {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.5rem 0;
    border-top: 1px dashed var(--line);
    border-bottom: 1px dashed var(--line);
  }
  .offer.featured .price-row {
    border-color: rgba(255, 255, 255, 0.18);
  }
  .price {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .from {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
    font-weight: 600;
  }
  :global(body.lang-zh) .from {
    text-transform: none;
    letter-spacing: 0.04em;
  }
  .amount {
    font-family: "Manrope", sans-serif;
    font-weight: 800;
    font-size: 1.7rem;
    letter-spacing: -0.02em;
    color: var(--ink);
    line-height: 1;
  }
  .normal {
    font-size: 0.95rem;
    color: var(--muted);
    text-decoration: line-through;
  }
  .tag-on {
    font-size: 0.82rem;
    color: var(--muted);
  }
  .tag-on strong {
    color: var(--ink);
    font-weight: 600;
  }

  .desc {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.92rem;
  }

  .features {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .features li {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    font-size: 0.9rem;
    color: var(--ink-2);
    line-height: 1.45;
  }
  .features li svg {
    color: var(--purple-600);
    flex-shrink: 0;
    margin-top: 3px;
  }
  .more-count {
    color: var(--muted);
    font-style: italic;
    font-size: 0.85rem;
    padding-left: 1.1rem;
  }
  .offer.featured .more-count {
    color: rgba(255, 255, 255, 0.7);
  }

  .addon {
    background: var(--purple-50);
    border: 1px solid var(--purple-100);
    border-radius: 4px;
    overflow: hidden;
  }
  .addon summary {
    padding: 0.75rem 1rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    list-style: none;
    user-select: none;
    font-size: 0.9rem;
  }
  .addon summary::-webkit-details-marker {
    display: none;
  }
  .addon-label {
    font-weight: 600;
    color: var(--purple-800);
    flex-grow: 1;
  }
  .addon-count {
    background: #fff;
    color: var(--purple-700);
    font-size: 0.72rem;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    font-weight: 600;
    border: 1px solid var(--purple-100);
  }
  .chev {
    color: var(--purple-700);
    transition: transform 0.2s ease;
  }
  .addon[open] .chev {
    transform: rotate(180deg);
  }
  .addon-items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border-top: 1px solid var(--purple-100);
  }
  @media (max-width: 520px) {
    .addon-items {
      grid-template-columns: 1fr;
    }
  }
  .addon-items li {
    padding: 0.55rem 1rem;
    font-size: 0.85rem;
    color: var(--ink-2);
    border-top: 1px dashed var(--purple-100);
  }
  .addon-items li:nth-child(-n + 2) {
    border-top: none;
  }
  @media (max-width: 520px) {
    .addon-items li:nth-child(2) {
      border-top: 1px dashed var(--purple-100);
    }
  }

  .meta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem 1rem;
    margin: 0;
    font-size: 0.82rem;
  }
  .meta div {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .meta dt {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--muted);
  }
  :global(body.lang-zh) .meta dt {
    text-transform: none;
    letter-spacing: 0.04em;
  }
  .meta dd {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.85rem;
  }

  .notes {
    list-style: none;
    margin: 0;
    padding: 0.75rem 1rem;
    background: var(--bg-soft);
    border-radius: 10px;
    font-size: 0.82rem;
    color: var(--muted);
    display: grid;
    gap: 0.35rem;
  }
  .offer.featured .notes {
    background: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.75);
  }

  .footer {
    margin-top: auto;
    padding-top: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .footer .btn {
    padding: 0.55rem 1rem;
    font-size: 0.85rem;
  }

  /* Compact variant (carousel cards) */
  .offer.compact header {
    padding-right: 3rem;
  }
</style>
