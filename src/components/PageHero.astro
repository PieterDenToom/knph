---
import { publicImage } from "../lib/publicImage";

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  /** Path under /public, e.g. "/photos/vaccinations-hero.webp" */
  image?: string;
  imageAlt?: string;
  /** CSS object-position, for photos whose subject isn't centred */
  imagePosition?: string;
}
const {
  eyebrow,
  title,
  description,
  image,
  imageAlt = "",
  imagePosition = "center",
} = Astro.props;

// Fall back to the text-only hero until the image file is actually added.
const hasImage = !!image && !!publicImage(image);
---

<section class:list={["page-hero", { "has-image": hasImage }]}>
  <div class="bg-shape" aria-hidden="true"></div>
  <div class="container inner">
    <div class="content">
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      <h1>{title}</h1>
      {description && <p>{description}</p>}
    </div>
    {
      hasImage && (
        <div class="media">
          <img
            src={encodeURI(image!)}
            alt={imageAlt}
            style={`object-position: ${imagePosition}`}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      )
    }
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    padding: clamp(3.5rem, 6vw, 5.5rem) 0 clamp(2.5rem, 5vw, 4rem);
    background: linear-gradient(180deg, #f5f3ff 0%, #ffffff 100%);
    overflow: hidden;
  }
  .bg-shape {
    position: absolute;
    top: -120px;
    right: -120px;
    width: 420px;
    height: 420px;
    background: radial-gradient(
      circle,
      rgba(139, 92, 246, 0.22) 0%,
      rgba(139, 92, 246, 0) 70%
    );
    border-radius: 50%;
    z-index: 0;
  }
  .inner {
    position: relative;
    z-index: 1;
  }
  .content {
    max-width: 760px;
  }
  .has-image .inner {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .media {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: 12px;
    overflow: hidden;
    background: linear-gradient(
      160deg,
      var(--purple-100) 0%,
      var(--purple-50) 100%
    );
    box-shadow: var(--shadow-lg);
  }
  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  @media (max-width: 860px) {
    .has-image .inner {
      grid-template-columns: 1fr;
    }
    .media {
      aspect-ratio: 16 / 10;
    }
  }
  p {
    font-size: 1.1rem;
    color: var(--muted);
    margin-top: 0.75rem;
  }
</style>
