---
import Icon from "./Icon.astro";
import { useTranslations, type Locale } from "../i18n";

interface Props {
  lang?: Locale;
}
const { lang = "en" } = Astro.props;
const t = useTranslations(lang);
const s = t.common.search;
---

<button
  type="button"
  id="search-trigger"
  class="search-trigger"
  aria-haspopup="dialog"
  aria-controls="search-dialog"
  aria-label={`${s.openLabel} (${s.shortcutHint})`}
  title={`${s.openLabel} (${s.shortcutHint})`}
>
  <Icon name="search" size={18} />
</button>

<div id="search-overlay" class="search-overlay" hidden>
  <div
    id="search-dialog"
    class="search-dialog"
    role="dialog"
    aria-modal="true"
    aria-label={s.inputLabel}
  >
    <div class="search-input-row">
      <Icon name="search" size={18} />
      <input
        id="search-input"
        type="text"
        placeholder={s.placeholder}
        aria-label={s.inputLabel}
        autocomplete="off"
        spellcheck="false"
      />
      <button type="button" id="search-close" aria-label={s.close}>
        <Icon name="close" size={18} />
      </button>
    </div>
    <div id="search-results" class="search-results" role="listbox"></div>
    <div class="search-footer">{s.resultsHint}</div>
  </div>
</div>

<script
  is:inline
  define:vars={{
    currentLang: lang,
    indexUrl: "/search-index.json",
    noResultsText: s.noResults,
  }}
>
  (function () {
    var trigger = document.getElementById("search-trigger");
    var overlay = document.getElementById("search-overlay");
    var dialog = document.getElementById("search-dialog");
    var input = document.getElementById("search-input");
    var closeBtn = document.getElementById("search-close");
    var results = document.getElementById("search-results");
    if (!trigger || !overlay || !dialog || !input || !results) return;

    var allEntries = null;
    var loadingPromise = null;
    var activeIndex = -1;
    var currentItems = [];

    function escapeHtml(str) {
      var div = document.createElement("div");
      div.textContent = str;
      return div.innerHTML;
    }

    function loadIndex() {
      if (allEntries) return Promise.resolve(allEntries);
      if (loadingPromise) return loadingPromise;
      loadingPromise = fetch(indexUrl)
        .then(function (res) {
          return res.json();
        })
        .then(function (data) {
          allEntries = data.filter(function (entry) {
            return entry.lang === currentLang;
          });
          return allEntries;
        })
        .catch(function () {
          allEntries = [];
          return allEntries;
        });
      return loadingPromise;
    }

    function openSearch() {
      overlay.hidden = false;
      document.documentElement.classList.add("search-lock");
      loadIndex();
      window.posthog && window.posthog.capture && window.posthog.capture("search_opened");
      setTimeout(function () {
        input.focus();
      }, 0);
    }

    function closeSearch() {
      overlay.hidden = true;
      document.documentElement.classList.remove("search-lock");
      trigger.focus();
    }

    function render(items) {
      currentItems = items;
      activeIndex = items.length > 0 ? 0 : -1;
      if (items.length === 0) {
        results.innerHTML = '<p class="search-empty">' + escapeHtml(noResultsText) + "</p>";
        return;
      }
      var groups = [];
      var byGroup = {};
      items.forEach(function (item) {
        if (!byGroup[item.group]) {
          byGroup[item.group] = [];
          groups.push(item.group);
        }
        byGroup[item.group].push(item);
      });
      var html = "";
      var flatIndex = 0;
      groups.forEach(function (group) {
        html += '<div class="search-group-label">' + escapeHtml(group) + "</div>";
        byGroup[group].forEach(function (item) {
          html +=
            '<a class="search-result" role="option" data-index="' +
            flatIndex +
            '" href="' +
            escapeHtml(item.url) +
            '">' +
            '<span class="search-result-title">' +
            escapeHtml(item.title) +
            "</span>" +
            '<span class="search-result-desc">' +
            escapeHtml(item.description || "") +
            "</span>" +
            "</a>";
          flatIndex += 1;
        });
      });
      results.innerHTML = html;
      updateActive();
    }

    function updateActive() {
      var nodes = results.querySelectorAll(".search-result");
      nodes.forEach(function (node, i) {
        if (i === activeIndex) {
          node.classList.add("active");
          node.scrollIntoView({ block: "nearest" });
        } else {
          node.classList.remove("active");
        }
      });
    }

    function score(entry, query) {
      var title = entry.title.toLowerCase();
      var desc = (entry.description || "").toLowerCase();
      if (title.indexOf(query) === 0) return 3;
      if (title.indexOf(query) > -1) return 2;
      if (desc.indexOf(query) > -1) return 1;
      return 0;
    }

    function runSearch(query) {
      var q = query.trim().toLowerCase();
      loadIndex().then(function (entries) {
        if (!q) {
          render(entries.slice(0, 8));
          return;
        }
        var scored = entries
          .map(function (entry) {
            return { entry: entry, s: score(entry, q) };
          })
          .filter(function (r) {
            return r.s > 0;
          })
          .sort(function (a, b) {
            return b.s - a.s;
          })
          .slice(0, 20)
          .map(function (r) {
            return r.entry;
          });
        render(scored);
      });
    }

    var debounceTimer;
    input.addEventListener("input", function () {
      clearTimeout(debounceTimer);
      var value = input.value;
      debounceTimer = setTimeout(function () {
        runSearch(value);
      }, 100);
    });

    trigger.addEventListener("click", openSearch);
    closeBtn.addEventListener("click", closeSearch);
    overlay.addEventListener("mousedown", function (e) {
      if (e.target === overlay) closeSearch();
    });

    document.addEventListener("keydown", function (e) {
      var isMeta = e.metaKey || e.ctrlKey;
      if (isMeta && e.key.toLowerCase() === "k") {
        e.preventDefault();
        if (overlay.hidden) {
          openSearch();
        } else {
          closeSearch();
        }
        return;
      }
      if (overlay.hidden) return;
      if (e.key === "Escape") {
        closeSearch();
      } else if (e.key === "ArrowDown") {
        e.preventDefault();
        if (currentItems.length === 0) return;
        activeIndex = (activeIndex + 1) % currentItems.length;
        updateActive();
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        if (currentItems.length === 0) return;
        activeIndex = (activeIndex - 1 + currentItems.length) % currentItems.length;
        updateActive();
      } else if (e.key === "Enter") {
        if (activeIndex > -1 && currentItems[activeIndex]) {
          window.location.href = currentItems[activeIndex].url;
        }
      }
    });

    results.addEventListener("mouseover", function (e) {
      var el = e.target.closest(".search-result");
      if (!el) return;
      activeIndex = Number(el.getAttribute("data-index"));
      updateActive();
    });
  })();
</script>

<style>
  .search-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border-radius: 6px;
    border: 1px solid transparent;
    background: var(--purple-700);
    color: #fff;
    cursor: pointer;
    flex-shrink: 0;
    box-shadow: 0 4px 12px rgba(91, 33, 182, 0.25);
    transition: background 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }
  .search-trigger:hover {
    background: var(--purple-800);
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(91, 33, 182, 0.3);
  }

  :global(html.search-lock) {
    overflow: hidden;
  }

  .search-overlay {
    position: fixed;
    inset: 0;
    background: rgba(26, 21, 48, 0.55);
    backdrop-filter: blur(2px);
    z-index: 200;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 10vh 1.25rem 2rem;
  }
  .search-overlay[hidden] {
    display: none;
  }

  .search-dialog {
    width: 100%;
    max-width: 620px;
    background: #fff;
    border-radius: 12px;
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    max-height: 70vh;
  }

  .search-input-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
  }
  .search-input-row input {
    flex-grow: 1;
    border: none;
    outline: none;
    font-size: 1rem;
    font-family: inherit;
    color: var(--ink);
    background: transparent;
  }
  .search-input-row input::placeholder {
    color: var(--muted);
  }
  #search-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 6px;
    border: none;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    flex-shrink: 0;
  }
  #search-close:hover {
    background: var(--purple-50);
    color: var(--purple-700);
  }

  .search-results {
    overflow-y: auto;
    padding: 0.5rem;
  }
  /* Results are rendered at runtime via innerHTML, so they never receive
     Astro's scoping attribute — these rules must stay global to apply. */
  :global(.search-group-label) {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    padding: 0.6rem 0.75rem 0.3rem;
  }
  :global(body.lang-zh .search-group-label) {
    text-transform: none;
    letter-spacing: 0.04em;
  }
  :global(.search-result) {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.6rem 0.75rem;
    border-radius: 8px;
    text-decoration: none;
  }
  :global(.search-result-title) {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--ink);
  }
  :global(.search-result-desc) {
    font-size: 0.82rem;
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  :global(.search-result.active),
  :global(.search-result:hover) {
    background: var(--purple-50);
  }
  :global(.search-result.active .search-result-title),
  :global(.search-result:hover .search-result-title) {
    color: var(--purple-800);
  }

  :global(.search-empty) {
    padding: 1.5rem 0.75rem;
    text-align: center;
    color: var(--muted);
    font-size: 0.9rem;
    margin: 0;
  }

  .search-footer {
    padding: 0.6rem 1.25rem;
    border-top: 1px solid var(--line);
    font-size: 0.75rem;
    color: var(--muted);
    background: var(--bg-soft);
  }

  @media (max-width: 600px) {
    .search-overlay {
      padding: 4vh 0.75rem 1.5rem;
    }
    .search-dialog {
      max-height: 82vh;
    }
  }
</style>
