---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { useTranslations, type Locale } from "../i18n";

interface Props {
  title?: string;
  description?: string;
  active?: "home" | "about" | "screening" | "vaccinations" | "chronic" | "contact";
  lang?: Locale;
}

const {
  title,
  description,
  active = "home",
  lang = "en",
} = Astro.props;

const t = useTranslations(lang);

const pageTitle = title ?? t.meta.siteName;
const pageDescription = description ?? t.meta.siteDescription;
const fullTitle =
  pageTitle === t.meta.siteName ? pageTitle : `${pageTitle} — Klinik Ng Poh Huat`;

// Replace this with your real GA4 Measurement ID (e.g. "G-ABC123XYZ").
// When left as the placeholder below, the analytics snippet stays inert.
const GA_MEASUREMENT_ID = "G-XXXXXXXXXX";
const analyticsEnabled =
  GA_MEASUREMENT_ID && !GA_MEASUREMENT_ID.includes("XXXX");
---

<!doctype html>
<html lang={t.meta.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#5B21B6" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta
      property="og:locale"
      content={lang === "zh" ? "zh_MY" : "en_MY"}
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@600;700;800&family=Noto+Sans+SC:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <title>{fullTitle}</title>

    {
      analyticsEnabled && (
        <>
          <script
            is:inline
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}
          />
          <script is:inline define:vars={{ GA_MEASUREMENT_ID }}>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);} // eslint-disable-line
            gtag('js', new Date());
            gtag('config', GA_MEASUREMENT_ID);
          </script>
        </>
      )
    }
  </head>
  <body class:list={[{ "lang-zh": lang === "zh" }]}>
    <a class="skip-link" href="#main">{t.common.skipLink}</a>
    <Header active={active} lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />

    <style is:global>
      :root {
        --purple-900: #3b0764;
        --purple-800: #4c1d95;
        --purple-700: #5b21b6;
        --purple-600: #6d28d9;
        --purple-500: #8b5cf6;
        --purple-300: #c4b5fd;
        --purple-100: #ede9fe;
        --purple-50: #f5f3ff;
        --ink: #1a1530;
        --ink-2: #2d2740;
        --muted: #6b6884;
        --line: #ece9f4;
        --bg: #ffffff;
        --bg-soft: #faf9ff;
        --surface: #f1f4f9;
        --surface-rgb: 241, 244, 249;
        --radius: 6px;
        --radius-sm: 4px;
        --shadow-sm: 0 1px 2px rgba(36, 18, 64, 0.04),
          0 2px 8px rgba(36, 18, 64, 0.04);
        --shadow-md: 0 4px 12px rgba(60, 30, 120, 0.06),
          0 12px 30px rgba(60, 30, 120, 0.08);
        --shadow-lg: 0 18px 50px rgba(60, 30, 120, 0.18);
        --max: 1160px;
        --gap: clamp(1.25rem, 2.5vw, 2rem);
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
      }

      html {
        scroll-behavior: smooth;
        -webkit-text-size-adjust: 100%;
      }

      body {
        font-family: "Inter", system-ui, -apple-system, "Segoe UI", Roboto,
          sans-serif;
        color: var(--ink);
        background: var(--bg);
        line-height: 1.6;
        font-size: 16px;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      body.lang-zh {
        font-family: "Noto Sans SC", "Inter", system-ui, -apple-system,
          "Segoe UI", Roboto, sans-serif;
      }

      body.lang-zh h1,
      body.lang-zh h2,
      body.lang-zh h3,
      body.lang-zh h4 {
        font-family: "Noto Sans SC", "Manrope", "Inter", system-ui, sans-serif;
        letter-spacing: -0.005em;
      }

      h1,
      h2,
      h3,
      h4 {
        font-family: "Manrope", "Inter", system-ui, sans-serif;
        color: var(--ink);
        line-height: 1.15;
        letter-spacing: -0.02em;
        margin: 0 0 0.5em;
      }

      h1 {
        font-size: clamp(2.25rem, 4.5vw, 3.5rem);
        font-weight: 800;
      }

      h2 {
        font-size: clamp(1.75rem, 3vw, 2.4rem);
        font-weight: 700;
      }

      h3 {
        font-size: 1.25rem;
        font-weight: 700;
      }

      p {
        margin: 0 0 1em;
        color: var(--ink-2);
      }

      a {
        color: var(--purple-700);
        text-decoration: none;
        transition: color 0.15s ease;
      }

      a:hover {
        color: var(--purple-800);
      }

      img {
        max-width: 100%;
        display: block;
      }

      ::selection {
        background: var(--purple-300);
        color: var(--purple-900);
      }

      .container {
        max-width: var(--max);
        margin: 0 auto;
        padding: 0 1.25rem;
      }

      .eyebrow {
        display: inline-block;
        text-transform: uppercase;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        color: var(--purple-700);
        background: var(--purple-100);
        padding: 0.4rem 0.8rem;
        border-radius: 999px;
        margin-bottom: 1rem;
      }

      body.lang-zh .eyebrow {
        text-transform: none;
        letter-spacing: 0.04em;
      }

      .section {
        padding: clamp(3.5rem, 7vw, 6rem) 0;
      }

      .section--soft {
        background: var(--bg-soft);
      }

      .section-head {
        max-width: 720px;
        margin: 0 auto clamp(2rem, 4vw, 3rem);
        text-align: center;
      }

      .section-head p {
        font-size: 1.05rem;
        color: var(--muted);
      }

      .grid {
        display: grid;
        gap: var(--gap);
      }

      .grid-2 {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .grid-3 {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .grid-4 {
        grid-template-columns: repeat(4, minmax(0, 1fr));
      }

      @media (max-width: 900px) {
        .grid-3,
        .grid-4 {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      @media (max-width: 600px) {
        .grid-2,
        .grid-3,
        .grid-4 {
          grid-template-columns: 1fr;
        }
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.85rem 1.4rem;
        border-radius: 6px;
        font-weight: 600;
        font-size: 0.95rem;
        line-height: 1;
        cursor: pointer;
        border: 1px solid transparent;
        transition: transform 0.15s ease, box-shadow 0.15s ease,
          background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
        white-space: nowrap;
      }

      .btn-primary {
        background: var(--purple-700);
        color: #fff;
        box-shadow: 0 8px 20px rgba(91, 33, 182, 0.25);
      }

      .btn-primary:hover {
        background: var(--purple-800);
        color: #fff;
        transform: translateY(-1px);
      }

      .btn-ghost {
        background: transparent;
        color: var(--purple-700);
        border-color: var(--purple-300);
      }

      .btn-ghost:hover {
        background: var(--purple-50);
        color: var(--purple-800);
      }

      .card {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: clamp(1.5rem, 2.5vw, 2rem);
        box-shadow: var(--shadow-sm);
        transition: transform 0.2s ease, box-shadow 0.2s ease,
          border-color 0.2s ease;
      }

      .card:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-md);
        border-color: var(--purple-100);
      }

      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--purple-700);
        color: #fff;
        padding: 0.5rem 1rem;
        border-radius: 0 0 8px 8px;
        z-index: 100;
      }

      .skip-link:focus {
        left: 1rem;
      }

      main {
        min-height: 50vh;
      }
    </style>
  </body>
</html>
