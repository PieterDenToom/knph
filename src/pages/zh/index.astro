---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import OfferCard from "../../components/OfferCard.astro";
import ServiceCard from "../../components/ServiceCard.astro";
import Icon from "../../components/Icon.astro";
import { useTranslations, localizedHref, type Locale } from "../../i18n";

const lang: Locale = "zh";
const t = useTranslations(lang);

const offers = await getCollection("offers");
const sortedOffers = [...offers].sort((a, b) => a.data.order - b.data.order);
const CLONE_COUNT = 2;
const cloneStart = sortedOffers.slice(-CLONE_COUNT);
const cloneEnd = sortedOffers.slice(0, CLONE_COUNT);
const carouselOffers = [...cloneStart, ...sortedOffers, ...cloneEnd];

const serviceIcons = ["stethoscope", "clipboard", "syringe", "heart"] as const;
const serviceHrefs = [
  "/about",
  "/health-screening",
  "/vaccinations",
  "/chronic-disease",
] as const;
---

<Layout lang={lang} active="home">
  <Hero lang={lang} />

  <section class="section" id="packages">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">{t.home.packages.eyebrow}</span>
        <h2>{t.home.packages.title}</h2>
        <p>{t.home.packages.lead}</p>
      </div>

      <div class="carousel-wrap">
        <button
          class="carousel-arrow prev"
          type="button"
          aria-label={t.common.carousel.prev}
        >
          <svg
            viewBox="0 0 24 24"
            width="20"
            height="20"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M15 6l-6 6 6 6" />
          </svg>
        </button>
        <div
          class="offer-carousel"
          role="region"
          aria-label={t.home.packages.title}
          aria-roledescription="carousel"
          tabindex="0"
          data-clones={CLONE_COUNT}
          data-real-count={sortedOffers.length}
        >
          <div class="offer-track">
            {
              carouselOffers.map((offer) => (
                <OfferCard
                  offer={offer}
                  variant="compact"
                  lang={lang}
                  noId
                />
              ))
            }
          </div>
        </div>
        <button
          class="carousel-arrow next"
          type="button"
          aria-label={t.common.carousel.next}
        >
          <svg
            viewBox="0 0 24 24"
            width="20"
            height="20"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M9 6l6 6-6 6" />
          </svg>
        </button>
      </div>
      <div class="carousel-counter" aria-live="polite">
        <span class="carousel-current">1</span>
        <span class="carousel-sep">/</span>
        <span class="carousel-total">{sortedOffers.length}</span>
      </div>

      <div class="below-grid">
        <a href={localizedHref("/health-screening", lang)} class="btn btn-ghost">
          {t.home.packages.cta}
          <svg
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14M13 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">{t.home.services.eyebrow}</span>
        <h2>{t.home.services.title}</h2>
        <p>{t.home.services.lead}</p>
      </div>

      <div class="grid grid-4">
        {
          t.home.services.items.map((item, i) => (
            <ServiceCard
              icon={serviceIcons[i]}
              title={item.title}
              description={item.description}
              href={localizedHref(serviceHrefs[i], lang)}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container why">
      <div>
        <span class="eyebrow">{t.home.why.eyebrow}</span>
        <h2>{t.home.why.title}</h2>
        <p>{t.home.why.lead}</p>
        <ul class="why-points">
          {
            t.home.why.points.map((p) => (
              <li>
                <Icon name="check" />
                <span>{p}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <aside class="card stat-card">
        {
          t.home.why.stats.map((s) => (
            <div class="stat">
              <span class="num">{s.num}</span>
              <span class="lbl">{s.label}</span>
            </div>
          ))
        }
      </aside>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container loc">
      <div>
        <span class="eyebrow">{t.home.location.eyebrow}</span>
        <h2>{t.home.location.title}</h2>
        <p>{t.home.location.lead}</p>
        <div class="loc-cta">
          <a href="tel:+60321818686" class="btn btn-primary">
            <Icon name="phone" size={16} /> {t.common.cta.callPhone}
          </a>
          <a
            href="https://wa.me/60321818686"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-ghost">{t.common.cta.whatsappUs}</a
          >
        </div>
      </div>
      <a
        class="map-link"
        href="https://www.google.com/maps/search/?api=1&query=Klinik+Ng+Poh+Huat+Bandar+Puteri+Puchong"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Open clinic location in Google Maps"
      >
        <div class="map-card">
          <div class="map-bg" aria-hidden="true"></div>
          <div class="pin">
            <Icon name="map" size={28} />
          </div>
          <div class="map-meta">
            <strong>{t.home.location.mapTitle}</strong>
            <span>{t.home.location.mapSub}</span>
          </div>
        </div>
      </a>
    </div>
  </section>
</Layout>

<script>
  const wraps = document.querySelectorAll<HTMLElement>(".carousel-wrap");
  for (const wrap of wraps) {
    const scroller = wrap.querySelector<HTMLElement>(".offer-carousel");
    const track = wrap.querySelector<HTMLElement>(".offer-track");
    if (!scroller || !track) continue;
    const cards = Array.from(track.children) as HTMLElement[];
    if (cards.length === 0) continue;

    const K = Number(scroller.dataset.clones ?? "0");
    const N = Number(scroller.dataset.realCount ?? cards.length);
    const total = cards.length;
    const isLoop = K > 0 && N > 0 && total === N + 2 * K;
    const toReal = (domIdx: number) =>
      isLoop ? ((((domIdx - K) % N) + N) % N) : domIdx;

    const counter = wrap.nextElementSibling as HTMLElement | null;
    const counterEl = counter?.classList.contains("carousel-counter")
      ? counter.querySelector<HTMLElement>(".carousel-current")
      : null;
    const prevBtn = wrap.querySelector<HTMLButtonElement>(".carousel-arrow.prev");
    const nextBtn = wrap.querySelector<HTMLButtonElement>(".carousel-arrow.next");

    let domIndex = isLoop ? K : 0;
    const setActive = (idx: number) => {
      domIndex = idx;
      cards.forEach((c, i) => c.classList.toggle("active", i === idx));
      if (counterEl) counterEl.textContent = String(toReal(idx) + 1);
      if (!isLoop) {
        if (prevBtn) prevBtn.toggleAttribute("disabled", idx === 0);
        if (nextBtn) nextBtn.toggleAttribute("disabled", idx === total - 1);
      }
    };

    const targetLeftFor = (idx: number) => {
      const card = cards[idx];
      const max = scroller.scrollWidth - scroller.clientWidth;
      return Math.max(
        0,
        Math.min(
          max,
          card.offsetLeft - (scroller.clientWidth - card.offsetWidth) / 2,
        ),
      );
    };

    const jumpTo = (idx: number) => {
      const target = targetLeftFor(idx);
      scroller.style.scrollSnapType = "none";
      scroller.scrollLeft = target;
      domIndex = idx;
      requestAnimationFrame(() => {
        scroller.style.scrollSnapType = "";
      });
      setActive(idx);
    };

    if (isLoop) jumpTo(K);

    let animFrame = 0;
    const scrollTo = (idx: number, onDone?: () => void) => {
      const card = cards[idx];
      if (!card) return;
      const target = targetLeftFor(idx);
      const start = scroller.scrollLeft;
      const distance = target - start;
      if (Math.abs(distance) < 1) {
        setActive(idx);
        onDone?.();
        return;
      }
      const duration = 400;
      const startTime = performance.now();
      scroller.style.scrollSnapType = "none";
      cancelAnimationFrame(animFrame);

      const step = (now: number) => {
        const t = Math.min(1, (now - startTime) / duration);
        const eased = 1 - Math.pow(1 - t, 3);
        scroller.scrollLeft = start + distance * eased;
        if (t < 1) {
          animFrame = requestAnimationFrame(step);
        } else {
          scroller.scrollLeft = target;
          scroller.style.scrollSnapType = "";
          setActive(idx);
          onDone?.();
        }
      };
      animFrame = requestAnimationFrame(step);
    };

    const checkLoop = () => {
      if (!isLoop) return;
      if (domIndex < K) {
        jumpTo(domIndex + N);
      } else if (domIndex >= K + N) {
        jumpTo(domIndex - N);
      }
    };

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            const idx = cards.indexOf(entry.target as HTMLElement);
            if (idx !== -1 && idx !== domIndex) setActive(idx);
          }
        }
      },
      {
        root: scroller,
        rootMargin: "0px -49% 0px -49%",
        threshold: 0,
      },
    );
    for (const card of cards) observer.observe(card);

    let scrollTimer = 0;
    scroller.addEventListener(
      "scroll",
      () => {
        clearTimeout(scrollTimer);
        scrollTimer = window.setTimeout(() => {
          const sr = scroller.getBoundingClientRect();
          const center = sr.left + sr.width / 2;
          let best = domIndex;
          let bestDist = Infinity;
          cards.forEach((c, i) => {
            const r = c.getBoundingClientRect();
            const d = Math.abs(center - (r.left + r.width / 2));
            if (d < bestDist) {
              bestDist = d;
              best = i;
            }
          });
          setActive(best);
          checkLoop();
        }, 150);
      },
      { passive: true },
    );

    prevBtn?.addEventListener("click", () => {
      scrollTo(domIndex - 1, checkLoop);
    });
    nextBtn?.addEventListener("click", () => {
      scrollTo(domIndex + 1, checkLoop);
    });

    cards.forEach((card, i) => {
      card.addEventListener("click", (e) => {
        if (i === domIndex) return;
        const targetEl = e.target as HTMLElement;
        if (targetEl.closest("a, button")) return;
        e.preventDefault();
        e.stopPropagation();
        scrollTo(i, checkLoop);
      });
    });

    scroller.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") {
        e.preventDefault();
        scrollTo(domIndex + 1, checkLoop);
      } else if (e.key === "ArrowLeft") {
        e.preventDefault();
        scrollTo(domIndex - 1, checkLoop);
      }
    });

    setActive(domIndex);
  }
</script>

<style>
  .carousel-wrap {
    position: relative;
    margin-inline: -1.25rem;
  }
  .offer-carousel {
    --offer-card-w: min(320px, 88vw);
    padding: 1rem 0;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .offer-carousel::-webkit-scrollbar {
    display: none;
  }
  .offer-carousel:focus-visible {
    outline: 2px solid var(--purple-300);
    outline-offset: 4px;
    border-radius: 6px;
  }
  .offer-track {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    padding-inline: max(
      var(--gap),
      calc(50% - var(--offer-card-w) / 2)
    );
  }
  .offer-track > :global(.offer) {
    flex: 0 0 var(--offer-card-w);
    scroll-snap-align: center;
    transform: scale(0.93);
    opacity: 0.6;
    filter: blur(1px);
    cursor: pointer;
    transition:
      transform 0.35s ease,
      opacity 0.35s ease,
      filter 0.35s ease;
  }
  .offer-track > :global(.offer.active) {
    transform: scale(1);
    opacity: 1;
    filter: none;
    cursor: default;
  }
  @media (prefers-reduced-motion: reduce) {
    .offer-track > :global(.offer) {
      transition: none;
    }
  }

  .carousel-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 3;
    width: 44px;
    height: 44px;
    border-radius: 6px;
    background: #fff;
    border: 1px solid var(--line);
    color: var(--purple-700);
    box-shadow: var(--shadow-md);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition:
      background 0.15s ease,
      color 0.15s ease,
      transform 0.15s ease,
      opacity 0.15s ease;
  }
  .carousel-arrow:hover:not([disabled]) {
    background: var(--purple-700);
    color: #fff;
    transform: translateY(-50%) scale(1.05);
  }
  .carousel-arrow[disabled] {
    opacity: 0.35;
    cursor: not-allowed;
  }
  .carousel-arrow.prev {
    left: 0.5rem;
  }
  .carousel-arrow.next {
    right: 0.5rem;
  }
  @media (max-width: 520px) {
    .carousel-arrow {
      width: 38px;
      height: 38px;
    }
    .carousel-arrow.prev {
      left: 0.25rem;
    }
    .carousel-arrow.next {
      right: 0.25rem;
    }
  }

  .carousel-counter {
    display: flex;
    justify-content: center;
    align-items: baseline;
    gap: 0.35rem;
    margin-top: 1rem;
    font-size: 0.85rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .carousel-current {
    font-weight: 600;
    color: var(--purple-700);
    font-size: 1rem;
  }
  .carousel-sep {
    opacity: 0.5;
  }

  .below-grid {
    margin-top: 2.5rem;
    text-align: center;
  }
  .why {
    display: grid;
    grid-template-columns: 1.2fr 0.9fr;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
  }
  @media (max-width: 900px) {
    .why {
      grid-template-columns: 1fr;
    }
  }
  .why-points {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }
  .why-points li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    color: var(--ink-2);
  }
  .why-points li :global(svg) {
    color: var(--purple-600);
    flex-shrink: 0;
    margin-top: 3px;
    background: var(--purple-50);
    border-radius: 999px;
    padding: 3px;
    box-sizing: content-box;
  }
  .stat-card {
    display: grid;
    gap: 1.25rem;
    background: linear-gradient(
      160deg,
      var(--purple-700) 0%,
      var(--purple-900) 100%
    );
    color: #fff;
    border: none;
    padding: 2rem;
  }
  .stat-card .stat {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .stat .num {
    font-family: "Manrope", sans-serif;
    font-weight: 800;
    font-size: 1.85rem;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .stat .lbl {
    font-size: 0.92rem;
    color: rgba(255, 255, 255, 0.78);
  }

  .loc {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
  }
  @media (max-width: 900px) {
    .loc {
      grid-template-columns: 1fr;
    }
  }
  .loc-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }
  .map-link {
    display: block;
    border-radius: 6px;
    overflow: hidden;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .map-link:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }
  .map-card {
    position: relative;
    background: linear-gradient(
      160deg,
      var(--purple-100) 0%,
      var(--purple-50) 100%
    );
    border: 1px solid var(--purple-100);
    border-radius: 6px;
    padding: 2.5rem 2rem;
    min-height: 240px;
    display: flex;
    align-items: flex-end;
    gap: 1rem;
    overflow: hidden;
  }
  .map-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(
        90deg,
        rgba(139, 92, 246, 0.12) 1px,
        transparent 1px
      ),
      linear-gradient(rgba(139, 92, 246, 0.12) 1px, transparent 1px);
    background-size: 24px 24px;
    opacity: 0.7;
    pointer-events: none;
  }
  .pin {
    position: relative;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #fff;
    color: var(--purple-700);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-md);
    flex-shrink: 0;
  }
  .map-meta {
    position: relative;
    display: flex;
    flex-direction: column;
    color: var(--ink);
  }
  .map-meta strong {
    font-family: "Manrope", sans-serif;
    font-size: 1.1rem;
  }
  .map-meta span {
    font-size: 0.88rem;
    color: var(--muted);
  }
</style>
