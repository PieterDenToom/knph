---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import Icon from "../../components/Icon.astro";
import { useTranslations, type Locale } from "../../i18n";

const lang: Locale = "zh";
const t = useTranslations(lang);

const valueIcons = ["family", "clock", "shield", "heart"] as const;
---

<Layout
  lang={lang}
  title={t.about.hero.eyebrow}
  description={t.about.hero.description}
  active="about"
>
  <PageHero
    eyebrow={t.about.hero.eyebrow}
    title={t.about.hero.title}
    description={t.about.hero.description}
  />

  <section class="section">
    <div class="container two-col">
      <div>
        <h2>{t.about.approach.title}</h2>
        {t.about.approach.paragraphs.map((p) => <p>{p}</p>)}
      </div>
      <div class="values">
        {
          t.about.values.map((v, i) => (
            <div class="value">
              <Icon name={valueIcons[i]} />
              <div>
                <h3>{v.title}</h3>
                <p>{v.description}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container hours-wrap">
      <div>
        <span class="eyebrow">{t.about.hours.eyebrow}</span>
        <h2>{t.about.hours.title}</h2>
        <p>{t.about.hours.lead}</p>
      </div>
      <div class="hours card">
        <table>
          <tbody>
            {
              t.about.hours.rows.map((r) => (
                <tr>
                  <th>{r.day}</th>
                  <td>{r.time}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <p class="note">
          <Icon name="clock" size={16} />
          {t.about.hours.note}
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 4vw, 4rem);
  }
  @media (max-width: 900px) {
    .two-col {
      grid-template-columns: 1fr;
    }
  }
  .values {
    display: grid;
    gap: 1.25rem;
  }
  .value {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.25rem;
    background: var(--bg-soft);
    border: 1px solid var(--line);
    border-radius: 6px;
  }
  .value :global(svg) {
    color: var(--purple-700);
    flex-shrink: 0;
    margin-top: 4px;
    width: 22px;
    height: 22px;
  }
  .value h3 {
    margin: 0 0 0.25rem;
    font-size: 1rem;
  }
  .value p {
    margin: 0;
    font-size: 0.92rem;
    color: var(--muted);
  }

  .hours-wrap {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
  }
  @media (max-width: 900px) {
    .hours-wrap {
      grid-template-columns: 1fr;
    }
  }
  .hours table {
    width: 100%;
    border-collapse: collapse;
  }
  .hours th,
  .hours td {
    text-align: left;
    padding: 0.85rem 0;
    border-bottom: 1px dashed var(--line);
    font-size: 0.98rem;
  }
  .hours th {
    font-weight: 600;
    color: var(--ink);
  }
  .hours td {
    color: var(--muted);
    text-align: right;
  }
  .hours tr:last-child th,
  .hours tr:last-child td {
    border-bottom: none;
  }
  .hours .note {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin: 1rem 0 0;
    font-size: 0.85rem;
    color: var(--muted);
    background: var(--purple-50);
    padding: 0.75rem 1rem;
    border-radius: 4px;
  }
  .hours .note :global(svg) {
    color: var(--purple-700);
    margin-top: 2px;
    flex-shrink: 0;
  }
</style>
