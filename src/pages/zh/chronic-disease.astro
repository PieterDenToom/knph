---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import Icon from "../../components/Icon.astro";
import { useTranslations, localizedHref, type Locale } from "../../i18n";

const lang: Locale = "zh";
const t = useTranslations(lang);

const conditionIcons = [
  "pill",
  "heart",
  "clipboard",
  "shield",
  "stethoscope",
  "family",
] as const;
---

<Layout
  lang={lang}
  title={t.chronic.hero.eyebrow}
  description={t.chronic.hero.description}
  active="chronic"
>
  <PageHero
    eyebrow={t.chronic.hero.eyebrow}
    title={t.chronic.hero.title}
    description={t.chronic.hero.description}
  />

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">{t.chronic.conditions.eyebrow}</span>
        <h2>{t.chronic.conditions.title}</h2>
        <p>{t.chronic.conditions.lead}</p>
      </div>

      <div class="grid grid-3">
        {
          t.chronic.conditions.items.map((c, i) => (
            <article class="cond">
              <div class="icon-wrap">
                <Icon name={conditionIcons[i]} size={26} />
              </div>
              <h3>{c.title}</h3>
              <p>{c.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container plan">
      <div>
        <span class="eyebrow">{t.chronic.plan.eyebrow}</span>
        <h2>{t.chronic.plan.title}</h2>
        <p>{t.chronic.plan.lead}</p>
      </div>
      <ol class="timeline">
        {
          t.chronic.plan.timeline.map((step, idx) => (
            <li>
              <span class="step-num">{String(idx + 1).padStart(2, "0")}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-block">
        <div>
          <h3>{t.chronic.cta.title}</h3>
          <p>{t.chronic.cta.lead}</p>
        </div>
        <div class="cta-buttons">
          <a href="tel:+60321818686" class="btn btn-primary">
            <Icon name="phone" size={16} /> {t.common.cta.callUs}
          </a>
          <a href={localizedHref("/contact", lang)} class="btn btn-ghost"
            >{t.chronic.cta.contactOptions}</a
          >
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .cond {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 1.75rem;
    transition: transform 0.2s ease, box-shadow 0.2s ease,
      border-color 0.2s ease;
    height: 100%;
  }
  .cond:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--purple-100);
  }
  .icon-wrap {
    width: 50px;
    height: 50px;
    border-radius: 4px;
    background: linear-gradient(135deg, var(--purple-100), var(--surface));
    color: var(--purple-700);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
    border: 1px solid var(--purple-100);
  }
  .cond h3 {
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
  }
  .cond p {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .plan {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: start;
  }
  @media (max-width: 900px) {
    .plan {
      grid-template-columns: 1fr;
    }
  }
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .timeline li {
    display: flex;
    gap: 1.25rem;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 1.5rem;
  }
  .step-num {
    font-family: "Manrope", sans-serif;
    font-weight: 800;
    font-size: 1.4rem;
    color: var(--purple-300);
    letter-spacing: -0.02em;
    flex-shrink: 0;
    min-width: 50px;
  }
  .timeline h3 {
    font-size: 1.05rem;
    margin: 0 0 0.3rem;
  }
  .timeline p {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .cta-block {
    background: linear-gradient(
      160deg,
      var(--purple-700) 0%,
      var(--purple-900) 100%
    );
    border-radius: 6px;
    padding: clamp(1.75rem, 3vw, 2.5rem);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .cta-block h3 {
    color: #fff;
    margin: 0 0 0.5rem;
    font-size: 1.3rem;
  }
  .cta-block p {
    color: rgba(255, 255, 255, 0.82);
    margin: 0;
    max-width: 48ch;
  }
  .cta-buttons {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .cta-buttons .btn-primary {
    background: #fff;
    color: var(--purple-800);
  }
  .cta-buttons .btn-primary:hover {
    background: var(--purple-50);
  }
  .cta-buttons .btn-ghost {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.4);
  }
  .cta-buttons .btn-ghost:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
  }
</style>
