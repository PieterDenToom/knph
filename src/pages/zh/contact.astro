---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import Icon from "../../components/Icon.astro";
import { useTranslations, type Locale } from "../../i18n";

const lang: Locale = "zh";
const t = useTranslations(lang);

const mapEmbed =
  "https://www.google.com/maps?q=Klinik+Ng+Poh+Huat+Bandar+Puteri+Puchong+No+101-G+Jalan+Puteri+5/7&output=embed";
---

<Layout
  lang={lang}
  title={t.contact.hero.eyebrow}
  description={t.contact.hero.description}
  active="contact"
>
  <PageHero
    eyebrow={t.contact.hero.eyebrow}
    title={t.contact.hero.title}
    description={t.contact.hero.description}
  />

  <section class="section">
    <div class="container layout">
      <div class="info">
        <div class="info-card">
          <div class="icon-wrap"><Icon name="phone" size={22} /></div>
          <div>
            <span class="label">{t.contact.info.phoneLabel}</span>
            <a href="tel:+60321818686" class="value">+60 3-2181 8686</a>
            <a
              href="https://wa.me/60321818686"
              target="_blank"
              rel="noopener noreferrer"
              class="link">{t.contact.info.openWhatsapp}</a
            >
          </div>
        </div>

        <div class="info-card">
          <div class="icon-wrap"><Icon name="clipboard" size={22} /></div>
          <div>
            <span class="label">{t.contact.info.emailLabel}</span>
            <a href="mailto:knph.leong@gmail.com" class="value">knph.leong@gmail.com</a>
            <span class="meta">{t.contact.info.emailMeta}</span>
          </div>
        </div>

        <div class="info-card">
          <div class="icon-wrap"><Icon name="map" size={22} /></div>
          <div>
            <span class="label">{t.contact.info.addressLabel}</span>
            <address class="value">
              {
                t.common.footer.addressLines.map((line, i) => (
                  <>
                    {line}
                    {i < t.common.footer.addressLines.length - 1 && <br />}
                  </>
                ))
              }
            </address>
            <div class="dir-links">
              <a
                href="https://www.google.com/maps/search/?api=1&query=Klinik+Ng+Poh+Huat+Bandar+Puteri+Puchong"
                target="_blank"
                rel="noopener noreferrer"
                class="link">{t.contact.info.googleMaps}</a
              >
              <a
                href="https://www.waze.com/ul?q=Klinik+Ng+Poh+Huat+Bandar+Puteri+Puchong&navigate=yes"
                target="_blank"
                rel="noopener noreferrer"
                class="link">{t.contact.info.waze}</a
              >
            </div>
          </div>
        </div>

        <div class="info-card">
          <div class="icon-wrap"><Icon name="clock" size={22} /></div>
          <div>
            <span class="label">{t.contact.info.hoursLabel}</span>
            <ul class="hours">
              {
                t.contact.info.hoursRows.map((r) => (
                  <li>
                    <span>{r.day}</span>
                    <strong>{r.time}</strong>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>

      <div class="map-col">
        <div class="map-frame">
          <iframe
            src={mapEmbed}
            title={t.contact.map.iframeTitle}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen></iframe>
        </div>
        <a
          class="map-cta btn btn-ghost"
          href="https://www.google.com/maps/dir/?api=1&destination=Klinik+Ng+Poh+Huat+Bandar+Puteri+Puchong"
          target="_blank"
          rel="noopener noreferrer"
        >
          {t.contact.map.getDirections}
          <svg
            viewBox="0 0 24 24"
            width="14"
            height="14"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14M13 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container faq">
      <div class="section-head">
        <span class="eyebrow">{t.contact.faq.eyebrow}</span>
        <h2>{t.contact.faq.title}</h2>
      </div>
      <div class="grid grid-2">
        {
          t.contact.faq.items.map((item) => (
            <div class="q card">
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  .layout {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: start;
  }
  @media (max-width: 900px) {
    .layout {
      grid-template-columns: 1fr;
    }
  }
  .info {
    display: grid;
    gap: 1rem;
  }
  .info-card {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 1.25rem 1.5rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .info-card:hover {
    border-color: var(--purple-100);
    box-shadow: var(--shadow-sm);
  }
  .icon-wrap {
    width: 44px;
    height: 44px;
    border-radius: 4px;
    background: var(--purple-50);
    color: var(--purple-700);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border: 1px solid var(--purple-100);
  }
  .label {
    display: block;
    text-transform: uppercase;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: var(--muted);
    margin-bottom: 0.25rem;
    font-weight: 600;
  }
  :global(body.lang-zh) .label {
    text-transform: none;
    letter-spacing: 0.04em;
  }
  .value {
    display: block;
    font-family: "Manrope", sans-serif;
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--ink);
    line-height: 1.4;
    font-style: normal;
  }
  a.value:hover {
    color: var(--purple-700);
  }
  .link {
    display: inline-block;
    margin-top: 0.4rem;
    font-size: 0.88rem;
    font-weight: 500;
  }
  .meta {
    display: block;
    margin-top: 0.4rem;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .dir-links {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 0.4rem;
  }
  .hours {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.35rem;
  }
  .hours li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.95rem;
  }
  .hours li span {
    color: var(--muted);
  }
  .hours li strong {
    color: var(--ink);
    font-weight: 600;
  }

  .map-col {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .map-frame {
    border-radius: 6px;
    overflow: hidden;
    box-shadow: var(--shadow-md);
    border: 1px solid var(--line);
    aspect-ratio: 4 / 3.6;
    background: var(--purple-50);
  }
  .map-frame iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  .map-cta {
    align-self: flex-start;
  }

  .faq .q h3 {
    font-size: 1.05rem;
    margin-bottom: 0.4rem;
  }
  .faq .q p {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }
</style>
