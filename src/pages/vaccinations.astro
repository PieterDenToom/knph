---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";
import { useTranslations, type Locale } from "../i18n";

const lang: Locale = "en";
const t = useTranslations(lang);

const groupIcons = ["shield", "family", "map"] as const;

const vaccines = await getCollection("vaccines");
const sortedVaccines = [...vaccines].sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Layout
  lang={lang}
  title={t.vaccinations.hero.eyebrow}
  description={t.vaccinations.hero.description}
  active="vaccinations"
>
  <PageHero
    eyebrow={t.vaccinations.hero.eyebrow}
    title={t.vaccinations.hero.title}
    description={t.vaccinations.hero.description}
  />

  <section class="section">
    <div class="container">
      <div class="grid grid-3">
        {
          t.vaccinations.groups.map((g, idx) => (
            <article class="vgroup">
              <div class="icon-wrap">
                <Icon name={groupIcons[idx]} size={26} />
              </div>
              <h3>{g.title}</h3>
              <ul>
                {g.items.map((i) => (
                  <li>
                    <svg
                      viewBox="0 0 24 24"
                      width="14"
                      height="14"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M5 12l5 5L20 7" />
                    </svg>
                    <span>{i}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--soft" id="vaccination-pricing-section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">{t.vaccinations.pricing.eyebrow}</span>
        <h2>{t.vaccinations.pricing.title}</h2>
        <p>{t.vaccinations.pricing.lead}</p>
      </div>
      <div class="price-table-wrap">
        <table class="price-table">
          <thead>
            <tr>
              <th scope="col">{t.vaccinations.pricing.vaccineHeader}</th>
              <th scope="col" class="num">
                {t.vaccinations.pricing.priceHeader}
              </th>
            </tr>
          </thead>
          <tbody>
            {
              sortedVaccines.map((v) => (
                <tr>
                  <td>
                    <span class="vname">{v.data.name}</span>
                    {v.data.note && <span class="vnote">{v.data.note}</span>}
                  </td>
                  <td class="num">
                    <span class="cur">{v.data.currency}</span>
                    {v.data.price}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container info-grid">
      <div>
        <span class="eyebrow">{t.vaccinations.info.eyebrow}</span>
        <h2>{t.vaccinations.info.title}</h2>
        <ul class="faq">
          {
            t.vaccinations.info.faq.map((item) => (
              <li>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
      <aside class="card cta-card">
        <h3>{t.vaccinations.cta.title}</h3>
        <p>{t.vaccinations.cta.lead}</p>
        <div class="buttons">
          <a href="tel:+60321818686" class="btn btn-primary" id="vacc-phone-cta">
            <Icon name="phone" size={16} /> {t.common.cta.callPhone}
          </a>
          <a
            href="https://wa.me/60321818686"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-ghost"
            id="vacc-whatsapp-cta">{t.common.cta.whatsapp}</a
          >
        </div>
      </aside>
    </div>
  </section>
</Layout>

<script is:inline>
  var pricingSection = document.getElementById('vaccination-pricing-section');
  if (pricingSection) {
    var pricingObserver = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          window.posthog?.capture('vaccination_pricing_viewed');
          pricingObserver.disconnect();
        }
      });
    }, { threshold: 0.3 });
    pricingObserver.observe(pricingSection);
  }

  document.getElementById('vacc-phone-cta')?.addEventListener('click', function () {
    window.posthog?.capture('phone_cta_clicked', { location: 'vaccinations_page' });
  });
  document.getElementById('vacc-whatsapp-cta')?.addEventListener('click', function () {
    window.posthog?.capture('whatsapp_cta_clicked', { location: 'vaccinations_page' });
  });
</script>

<style>
  .vgroup {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 1.75rem;
    transition: transform 0.2s ease, box-shadow 0.2s ease,
      border-color 0.2s ease;
  }
  .vgroup:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--purple-100);
  }
  .icon-wrap {
    width: 50px;
    height: 50px;
    border-radius: 14px;
    background: linear-gradient(135deg, var(--purple-100), #fff);
    color: var(--purple-700);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
    border: 1px solid var(--purple-100);
  }
  .vgroup h3 {
    font-size: 1.1rem;
    margin-bottom: 1rem;
  }
  .vgroup ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .vgroup ul li {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    font-size: 0.93rem;
    color: var(--ink-2);
  }
  .vgroup ul li svg {
    color: var(--purple-600);
    flex-shrink: 0;
    margin-top: 4px;
  }

  .price-table-wrap {
    margin-top: 2rem;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }
  .price-table {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }
  .price-table thead th {
    background: var(--purple-50);
    color: var(--purple-800);
    font-family: "Manrope", sans-serif;
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.9rem 1.5rem;
    text-align: left;
    border-bottom: 1px solid var(--purple-100);
  }
  .price-table th.num,
  .price-table td.num {
    text-align: right;
  }
  .price-table tbody tr + tr td {
    border-top: 1px solid var(--line);
  }
  .price-table td {
    padding: 1rem 1.5rem;
    vertical-align: middle;
  }
  .price-table .vname {
    display: block;
    color: var(--ink);
    font-weight: 600;
  }
  .price-table .vnote {
    display: block;
    color: var(--muted);
    font-size: 0.85rem;
    margin-top: 0.15rem;
  }
  .price-table .cur {
    color: var(--muted);
    font-weight: 500;
    margin-right: 0.35rem;
    font-size: 0.9em;
  }
  .price-table td.num {
    font-weight: 700;
    color: var(--purple-800);
  }
  @media (max-width: 520px) {
    .price-table thead th,
    .price-table td {
      padding: 0.85rem 1rem;
    }
  }

  .info-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: start;
  }
  @media (max-width: 900px) {
    .info-grid {
      grid-template-columns: 1fr;
    }
  }
  .faq {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .faq li {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 1.25rem 1.5rem;
  }
  .faq h3 {
    font-size: 1rem;
    margin: 0 0 0.35rem;
  }
  .faq p {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .cta-card {
    position: sticky;
    top: 110px;
    background: linear-gradient(
      160deg,
      var(--purple-700) 0%,
      var(--purple-900) 100%
    );
    color: #fff;
    border: none;
  }
  .cta-card h3 {
    color: #fff;
    font-size: 1.2rem;
  }
  .cta-card p {
    color: rgba(255, 255, 255, 0.85);
  }
  .cta-card .buttons {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-top: 1rem;
  }
  .cta-card .btn-primary {
    background: #fff;
    color: var(--purple-800);
  }
  .cta-card .btn-primary:hover {
    background: var(--purple-50);
  }
  .cta-card .btn-ghost {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.4);
  }
  .cta-card .btn-ghost:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
  }
</style>
